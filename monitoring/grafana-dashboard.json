{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Nguồn dữ liệu Prometheus trong cụm Kubernetes",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Đề tài 3: Giám sát Tự động Co giãn Dịch vụ Web (HPA vs KEDA)",
  "uid": "web-autoscaling-dt3",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": true,
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0,
        "label": "Datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "1. Tải đầu vào (Throughput - RPS) & Tỷ lệ lỗi quá tải (Error Rate)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{handler=~\"/api/.*\"}[30s]))",
          "legendFormat": "Tổng tải yêu cầu (Total RPS)"
        },
        {
          "refId": "B",
          "expr": "sum(rate(app_processed_jobs_total{status=\"rejected_overload\"}[30s])) or vector(0)",
          "legendFormat": "Lỗi quá tải hàng đợi (HTTP 503 / s)"
        }
      ]
    },
    {
      "id": 2,
      "title": "2. Chỉ số Nghiệp vụ: Độ dài Hàng đợi (Queue Length) & In-flight Requests",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(app_queue_length)",
          "legendFormat": "Tổng yêu cầu đang chờ (Total Queue Length)"
        },
        {
          "refId": "B",
          "expr": "avg(app_queue_length)",
          "legendFormat": "Trung bình hàng đợi mỗi Pod (Avg Queue / Pod)"
        },
        {
          "refId": "C",
          "expr": "sum(app_in_flight_requests)",
          "legendFormat": "Tổng yêu cầu đang xử lý (Total In-Flight)"
        }
      ]
    },
    {
      "id": 3,
      "title": "3. Số lượng Bản sao đang hoạt động (Active Pod Replicas)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 3,
            "fillOpacity": 25
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{service=\"web-service\"})",
          "legendFormat": "Số bản sao thực tế (Active Replicas)"
        }
      ]
    },
    {
      "id": 4,
      "title": "4. Độ trễ phản hồi p95 (p95 Latency & Queue Wait Time)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{handler=~\"/api/.*\"}[30s])) by (le))",
          "legendFormat": "p95 Độ trễ toàn trình (End-to-End p95 Latency)"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(app_queue_wait_duration_seconds_bucket[30s])) by (le))",
          "legendFormat": "p95 Thời gian nằm chờ trong Queue"
        }
      ]
    },
    {
      "id": 5,
      "title": "5. Mức tiêu thụ Tài nguyên CPU (CPU Usage - Cores)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"default\", pod=~\"web-service.*\", container!=\"\", container!=\"POD\"}[1m])) by (pod)",
          "legendFormat": "CPU Pod: {{pod}}"
        },
        {
          "refId": "B",
          "expr": "avg(rate(container_cpu_usage_seconds_total{namespace=\"default\", pod=~\"web-service.*\", container!=\"\", container!=\"POD\"}[1m]))",
          "legendFormat": "Trung bình CPU mỗi Pod (Avg CPU/Pod)"
        }
      ]
    },
    {
      "id": 6,
      "title": "6. Mức tiêu thụ Bộ nhớ RAM (Memory Working Set)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(container_memory_working_set_bytes{namespace=\"default\", pod=~\"web-service.*\", container!=\"\", container!=\"POD\"}) by (pod)",
          "legendFormat": "RAM Pod: {{pod}}"
        },
        {
          "refId": "B",
          "expr": "sum(container_memory_working_set_bytes{namespace=\"default\", pod=~\"web-service.*\", container!=\"\", container!=\"POD\"})",
          "legendFormat": "Tổng RAM toàn dịch vụ (Total Memory)"
        }
      ]
    }
  ]
}
